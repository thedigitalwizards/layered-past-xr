{
  "name": "layered-past-xr",
  "version": "0.1.0",
  "private": true,
  "description": "An open WebXR framework for showing who interprets a heritage object, on what evidence, and how certain we are.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "validate": "node scripts/validate-content.ts",
    "export": "node scripts/export.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/gentium-book-plus": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
